# Copy to .env and fill in your MySQL login. .env is never committed.
HYPECHECK_DB_HOST=localhost
HYPECHECK_DB_PORT=3306
HYPECHECK_DB_USER=hypecheck
HYPECHECK_DB_PASSWORD=change-me
HYPECHECK_DB_NAME=hypecheck
HYPECHECK_TEST_DB_NAME=hypecheck_test

# Hosted MySQL (e.g. on Vercel): one connection string instead of the values above.
# HYPECHECK_DATABASE_URL=mysql://user:password@host:port/dbname?ssl-mode=REQUIRED
# Optional: CA certificate text for full TLS verification (\n for newlines).
# HYPECHECK_DB_SSL_CA_PEM=
# Optional private Unix socket; used only without HYPECHECK_DATABASE_URL.
HYPECHECK_DB_SOCKET=

# Optional account signup code; local registration is open when unset.
# HYPECHECK_SIGNUP_CODE=
# Optional Google OAuth; register http://127.0.0.1:4175/api/auth/google/callback first.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# HYPECHECK_GOOGLE_SIGNUP=open
